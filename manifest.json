{
    "manifest_version": 3,
    "name": "屏蔽B站推广视频",
    "version": "1.0",
    "description": "自动屏蔽B站的推广视频,即右下角带小火箭的视频,用于捕获逃过Adguard的漏网之鱼(偶尔会有). 仍有遗漏？请联系 zipdyefox@exdonuts.com",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://*.bilibili.com/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "permissions": ["activeTab", "storage"],
    "action": {
        "default_popup": "popup.html"
    }

    
}    
